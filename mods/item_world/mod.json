{
  "id": "item_world",
  "name": "Item World - Multiplicador de Nível & Inocentes",
  "category": "Item World",
  "version": "1.0.0",
  "author": "Disgaea Mayhem Mod Team",
  "description": "Acelera a evolução no Mundo dos Itens. Quando ativado (ON), o hook residente em memória intercepta a conclusão de cada andar multiplicando o ganho de níveis e subjugando 100% dos Inocentes automaticamente.",
  "type": "toggle",
  "enabled": true,
  "plugin": "item_world.dll",
  "components": [
    "mods/item_world/item_world.dll",
    "mods/item_world/APLICAR_MOD_ITEM_WORLD.exe",
    "mods/item_world/APLICAR_MOD_ITEM_WORLD.bat"
  ],
  "options": [
    {
      "id": "levels_per_floor",
      "name": "Níveis de Equipamento por Andar (+Lv)",
      "type": "slider_int",
      "min": 1,
      "max": 10,
      "default": 5,
      "value": 5
    },
    {
      "id": "auto_subdue",
      "name": "Subjugar Inocentes Automaticamente (100%)",
      "type": "toggle",
      "default": true,
      "value": true
    },
    {
      "id": "mystery_room_rate",
      "name": "Taxa de Spawn de Mystery Rooms (%)",
      "type": "slider_int",
      "min": 10,
      "max": 100,
      "default": 75,
      "value": 75
    }
  ]
}
