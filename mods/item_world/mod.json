{
  "schema_version": 1,
  "id": "item_world",
  "name": "Item World - Multiplicadores",
  "category": "Item World",
  "version": "2.4.0",
  "author": "Disgaea Mayhem Mod Team",
  "description": "Progresso de nivel e Item Points do Item World. A raridade minima cobre os tres caminhos do Item World; a option global estende a todo o jogo.",
  "type": "toggle",
  "load_order": 110,
  "plugin": "item_world.dll",
  "options": [
    {
      "id": "level_exp_enabled",
      "name": "Multiplicar Progresso de Nível",
      "type": "toggle"
    },
    {
      "id": "level_exp_multiplier",
      "name": "Progresso de Nível (x)",
      "type": "slider_float",
      "min": 1.0,
      "max": 20.0
    },
    {
      "id": "item_points_enabled",
      "name": "Multiplicar Item Points",
      "type": "toggle"
    },
    {
      "id": "item_point_multiplier",
      "name": "Item Points (x)",
      "type": "slider_float",
      "min": 1.0,
      "max": 200.0
    },
    {
      "id": "rarity_enabled",
      "name": "Raridade Minima - somente Item World",
      "type": "toggle"
    },
    {
      "id": "rarity_global",
      "name": "Estender Raridade a TODO o jogo (bau, loja, batalha)",
      "type": "toggle"
    },
    {
      "id": "minimum_rarity",
      "name": "Raridade Mínima",
      "type": "slider_int",
      "min": 0,
      "max": 100
    }
  ]
}
