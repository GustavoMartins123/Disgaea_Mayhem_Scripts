{
  "schema_version": 1,
  "id": "item_world",
  "name": "Item World - Multiplicadores",
  "category": "Item World",
  "version": "2.3.0",
  "author": "Disgaea Mayhem Mod Team",
  "description": "Controla o progresso de nível, os Item Points e a raridade dos equipamentos obtidos no Item World.",
  "type": "toggle",
  "load_order": 110,
  "plugin": "item_world.dll",
  "components": [
    "mods/item_world/item_world.dll"
  ],
  "options": [
    {
      "id": "level_exp_enabled",
      "name": "Multiplicar Progresso de Nível",
      "type": "toggle"
    },
    {
      "id": "level_exp_multiplier",
      "name": "Progresso de Nível (x)",
      "type": "slider_float",
      "min": 1.0,
      "max": 20.0
    },
    {
      "id": "item_points_enabled",
      "name": "Multiplicar Item Points",
      "type": "toggle"
    },
    {
      "id": "item_point_multiplier",
      "name": "Item Points (x)",
      "type": "slider_float",
      "min": 1.0,
      "max": 20.0
    },
    {
      "id": "rarity_enabled",
      "name": "Melhorar Raridade dos Equipamentos",
      "type": "toggle"
    },
    {
      "id": "minimum_rarity",
      "name": "Raridade Mínima",
      "type": "slider_int",
      "min": 0,
      "max": 100
    }
  ]
}
